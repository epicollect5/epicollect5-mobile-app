{
  "permissions": {
    "allow": [
      "Shell(gh auth status:*)",
      "Shell(gh label list:*)",
      "Shell(gh release view:*)",
      "Shell(command -v gh:*)",
      "Shell(rm docs/issues/draft/*.md)",
      "Shell(npx vitest *)",
      "Shell(NODE_ENV=test npx vitest *)",
      "Shell(node scripts/check-node-version.js:*)",
      "Shell(node scripts/check-release-bundle.js:*)",
      "Shell(git status:*)",
      "Shell(git diff:*)",
      "Shell(git log:*)",
      "Shell(git show:*)",
      "Shell(git branch:*)",
      "Shell(git rev-parse:*)",
      "Shell(git ls-files:*)",
      "Shell(git add:*)",
      "Shell(git commit:*)",
      "Shell(mkdir:*)",
      "Shell(npx lint:*)",
      "Shell(npm run lint:*)",
      "Shell(greptile review:*)",
      "mcp__fff__multi_grep",
      "mcp__fff__grep"
    ],
    "ask": [
      "Shell(git push:*)",
      "Shell(git tag:*)",
      "Shell(git reset:*)",
      "Shell(gh issue create:*)",
      "Shell(gh release upload:*)"
    ],
    "deny": [
      "Shell(rm -rf:*)",
      "Shell(npm install:*)",
      "Shell(git push --force:*)",
      "Shell(git reset --hard:*)",
      "Shell(git clean -:*)"
    ],
    "defaultMode": "default"
  }
}
