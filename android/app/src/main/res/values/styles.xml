<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: DayNight so OS-rendered dialogs (date/time
         pickers, system sheets) follow the device dark setting. The purple
         status bar/brand colors are explicit and identical in both modes. -->
    <style name="AppTheme"
        parent="Theme.AppCompat.DayNight.NoActionBar">
    </style>

    <style name="AppTheme.NoActionBar"
        parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Epicollect5 Colors on light theme -->
        <item name="colorPrimaryDark">#673C90</item>
        <item name="colorAccent">#673C90</item>
        <item name="android:statusBarColor">#331e48</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch"
        parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

    <!-- Brand accents for the Capawesome datetime-picker dialogs. The plugin
         hardcodes its own stock framework dialog themes (no color params, no
         AppTheme inheritance), so without this the sheets fall back to
         default device colors. Redefining the same style names here wins over
         the AAR at resource-merge time (app > library); the spinner variants
         inherit these items via their parents. Keep in sync with the style
         names in the plugin's android/src/main/res/values/styles.xml — the
         datetime-picker.spec.js test fails if they drift. Accent #673C90 is
         the brand primary and matches what the legacy WebView pickers
         resolved from AppTheme (identical in both modes, so one definition
         covers light and dark). -->
    <style name="MaterialLightTheme"
        parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#673C90</item>
        <item name="android:colorControlActivated">#673C90</item>
    </style>

    <style name="MaterialDarkTheme"
        parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#673C90</item>
        <item name="android:colorControlActivated">#673C90</item>
    </style>
</resources>