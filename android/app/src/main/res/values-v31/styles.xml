<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowSplashScreenBackground">@color/white</item>
        <!-- Pin the splash icon explicitly: a dedicated 1024px asset with the
             logo inside the mask safe zone and a baked-in white background,
             plus a forced white backing. Relying on the launcher adaptive icon
             broke on some builds (e.g. Galaxy S25 rendered the bare logo with
             no white circle while an A33 on the same OS kept it). -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/white</item>
    </style>
</resources>