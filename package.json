{
  "name": "uk.ac.imperial.epicollect.five",
  "version": "98.0.0",
  "private": true,
  "type": "module",
  "description": "Free and easy-to-use mobile data-gathering platform",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "jetifier",
    "serve": "vite",
    "build": "node scripts/check-node-version.js && vite build",
    "test:unit": "node scripts/check-node-version.js && vitest",
    "lint": "eslint .",
    "prenative:prod": "node scripts/check-node-version.js && vitest --run --silent",
    "native:debug": "node scripts/check-node-version.js && VITE_MODE=WEBVIEW VITE_DEBUG=1 vite build && npx cap copy --inline",
    "native:prod": "node scripts/check-node-version.js && VITE_MODE=WEBVIEW VITE_DEBUG= VITE_BYPASS_UNIQUENESS= vite build && npx cap copy --inline",
    "native:browser": "node scripts/check-node-version.js && VITE_MODE=WEBVIEW vite --host --port 8080",
    "native:copy": "node scripts/check-node-version.js && npx cap copy --no-build",
    "android:open": "node scripts/check-node-version.js && VITE_MODE=WEBVIEW vite build && npx cap copy android && npx cap open android",
    "android:build": "node scripts/check-node-version.js && VITE_MODE=WEBVIEW VITE_DEBUG= vite build && npx cap copy android",
    "dev-build": "vite build --mode development --sourcemap",
    "ios:open": "node scripts/check-node-version.js && VITE_MODE=WEBVIEW vite build && npx cap copy ios && npx cap open ios",
    "ios:build": "node scripts/check-node-version.js && VITE_MODE=WEBVIEW VITE_DEBUG= vite build && npx cap copy ios",
    "preprod": "node scripts/check-node-version.js && vitest --run --silent",
    "prod": "node scripts/check-node-version.js && VITE_MODE=WEBVIEW VITE_DEBUG= vite build && npx cap copy",
    "britest": "vitest --browser.name=chrome",
    "coverage": "vitest --coverage",
    "vitest-ui": "vitest --ui",
    "vitest": "vitest",
    "pwa:browser": "rm -rf dist && VITE_MODE=PWA VITE_DEBUG=1 vite --port 1234 --host",
    "prepwa:prod": "node scripts/check-node-version.js && vitest --run --silent",
    "pwa:prod": "node scripts/check-node-version.js && VITE_MODE=PWA VITE_DEBUG= vite build",
    "pwa:debug": "node scripts/check-node-version.js && VITE_MODE=PWA VITE_DEBUG=1 vite build",
    "prerollbar": "npm run native:prod",
    "rollbar": "./rollbar-upload.sh",
    "cmd": "bash -c 'source \"$HOME/.nvm/nvm.sh\" && nvm use 22 && exec cmd'"
  },
  "dependencies": {
    "@awesome-cordova-plugins/wheel-selector": "^5.44.0",
    "@capacitor/action-sheet": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/barcode-scanner": "^2.0.3",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/dialog": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capacitor/toast": "^8.0.0",
    "@capawesome-team/capacitor-android-foreground-service": "^8.1.0",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.2",
    "@capgo/capacitor-zip": "^8.1.5",
    "@ionic-native/core": "^5.36.0",
    "@ionic-native/globalization": "^5.32.1",
    "@ionic/core": "^9.0.0",
    "@ionic/vue": "^9.0.0",
    "@ionic/vue-router": "^9.0.0",
    "@whiteguru/capacitor-plugin-video-editor": "github:epicollect5/capacitor-plugin-video-editor",
    "an-array-of-english-words": "^2.0.0",
    "an-array-of-german-words": "^1.2.0",
    "an-array-of-spanish-words": "^2.0.0",
    "axios": "^1.18.0",
    "capacitor-native-settings": "^8.2.0",
    "cordova-plugin-file": "^6.0.2",
    "cordova-plugin-file-transfer": "git+https://github.com/sitewaerts/cordova-plugin-file-transfer.git#e19d57fa1932f64daa0a980da63baa12c5f2033b",
    "cordova-plugin-geolocation": "^4.1.0",
    "cordova-plugin-globalization": "^1.11.0",
    "cordova-plugin-googleplus": "github:epicollect5/cordova-plugin-googleplus#fix-signout",
    "cordova-plugin-media": "github:epicollect5/cordova-plugin-media",
    "cordova-plugin-media-capture": "github:epicollect5/cordova-plugin-media-capture",
    "cordova-plugin-sign-in-with-apple": "^0.1.2",
    "cordova-sqlite-storage": "^7.0.0",
    "cordova-wheel-selector-plugin": "^1.1.7",
    "cordova.plugins.diagnostic": "github:epicollect5/cordova-diagnostic-plugin",
    "date-fns": "^2.25.0",
    "flush-promises": "^1.0.2",
    "jszip": "^3.7.1",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "leaflet.fullscreen": "^5.3.0",
    "papaparse": "^5.5.3",
    "pinia": "^3.0.4",
    "pinia-logger": "^1.3.12",
    "proj4": "^2.8.0",
    "randexp": "^0.5.3",
    "rollbar": "3.0.0-beta.5",
    "signature_pad": "^5.1.4",
    "slugify": "^1.6.5",
    "swiper": "^12.1.2",
    "utm": "^1.1.1",
    "uuid": "^8.3.2",
    "vue": "^3.5.0",
    "vue-datepicker-next": "^1.0.2",
    "vue-router": "^5.0.0",
    "vue-scroll-picker": "^1.1.1",
    "vue3-dropzone": "^2.0.1",
    "vue3-scroll-picker": "^0.1.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.0.0",
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@pinia/testing": "^0.1.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "@vue/compiler-sfc": "^3.4.27",
    "@vue/test-utils": "^2.4.1",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "globals": "^15.0.0",
    "gulp": "^4.0.2",
    "gulp-shell": "^0.8.0",
    "jetifier": "^2.0.0",
    "jsdom": "^20.0.0",
    "minimist": "^1.2.8",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.63.3",
    "typescript": "^5.1.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^9.4.3"
  }
}
